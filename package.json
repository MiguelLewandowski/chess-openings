{
  "name": "chess-openings",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo dev --filter=@chess-openings/web",
    "dev:api": "turbo dev --filter=@chess-openings/api",
    "dev:all": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "start": "pnpm --filter @chess-openings/web start",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "test:domain": "turbo run test --filter=@chess-openings/domain",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:reviews": "tsx prisma/seed-reviews.ts",
    "lessons:generate": "pnpm --filter @chess-openings/lesson-author generate",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2"
  },
  "devDependencies": {
    "@prisma/config": "^6.19.2",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "prisma": "^6.19.2",
    "tsx": "^4.21.0",
    "turbo": "^2.9.18",
    "typescript": "^5"
  }
}
