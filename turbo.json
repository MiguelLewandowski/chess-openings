{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": ["prisma/schema.prisma"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_API_URL", "DATABASE_URL"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      // The API's e2e suite boots the real app against a real database. Turbo hides any
      // variable a task does not declare, so without this the suite sees no DATABASE_URL
      // in CI and every test fails on connection.
      "env": ["DATABASE_URL", "SESSION_SECRET", "WEB_ORIGIN"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "SESSION_SECRET", "WEB_ORIGIN"],
      "cache": false
    }
  }
}
