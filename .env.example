# ─────────────────────────────────────────────────────────────────────────────
# Environment template — copy to `.env` and fill in the values.
# The monorepo uses three .env files (all gitignored). This root file documents
# all of them in one place for onboarding.
# ─────────────────────────────────────────────────────────────────────────────

# ── Root `.env` (this file) ──────────────────────────────────────────────────
# Used only by the Prisma CLI (`pnpm exec prisma ...`) and the seeds.
DATABASE_URL="postgresql://admin:password123@localhost:5432/chessopenings?schema=public"


# ── apps/web/.env (Next.js frontend — never talks to the database) ────────────
# API_URL="http://localhost:3001/api"            # runtime, server-side only
# SESSION_SECRET="shared-secret-between-web-and-api"   # MUST match the API's


# ── apps/api/.env (NestJS backend) ───────────────────────────────────────────
# DATABASE_URL="postgresql://admin:password123@localhost:5432/chessopenings?schema=public"
# SESSION_SECRET="shared-secret-between-web-and-api"   # MUST match across web/api
# GEMINI_API_KEY=""                                    # optional — only for study import
# PORT=3001
