# Copy to apps/web/.env and fill in.

# Address of the API, read at runtime by the server (Server Components and Server Actions).
# The browser never calls the API directly, so this is not a NEXT_PUBLIC_* variable and does
# not need to be known at build time. Required in production; defaults to localhost in dev.
API_URL="http://localhost:3001/api"

# Signs the session cookie. Must be byte-for-byte identical to apps/api's SESSION_SECRET.
# In production a missing value throws instead of falling back.
SESSION_SECRET="um-segredo-compartilhado"
