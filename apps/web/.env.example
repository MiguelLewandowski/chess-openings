# Copy to apps/web/.env and fill in.

# Baked into the client bundle at BUILD time, not read at runtime: in Docker it must be
# passed as a --build-arg, and on Railway it must be set before the build step.
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Signs the session cookie. Must be byte-for-byte identical to apps/api's SESSION_SECRET.
# In production a missing value throws instead of falling back.
SESSION_SECRET="um-segredo-compartilhado"
