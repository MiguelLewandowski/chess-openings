# Copy to apps/api/.env and fill in.
# In production (NODE_ENV=production) the API refuses to start if DATABASE_URL or
# SESSION_SECRET are missing — there are no insecure fallbacks outside development.

DATABASE_URL="postgresql://admin:password123@localhost:5432/chessopenings?schema=public"

# Must be byte-for-byte identical to apps/web's SESSION_SECRET.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="um-segredo-compartilhado"

# Browser origin allowed by CORS. In production set it to the deployed web URL.
WEB_ORIGIN="http://localhost:3000"

# Required only to import Lichess studies (the AI coach narration).
GEMINI_API_KEY=""

PORT=3001
